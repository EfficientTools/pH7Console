{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pH7Console",
  "version": "1.0.0",
  "identifier": "com.efficienttools.ph7console",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ph7console"]
      }
    }
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev -- --port 5174",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pH7Console - Private Command Console",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "fullscreen": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 EfficientTools",
    "externalBin": [
      "binaries/llama-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "longDescription": "A private command console with a real PTY, cancellable on-device assistance, adaptive workflows, and encrypted local history",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "13.3",
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [
      "PrivacyInfo.xcprivacy",
      "resources/models/terminal-assistant.gguf",
      "resources/models/NOTICE.md",
      "resources/models/LICENSE-QWEN",
      "resources/models/LICENSE-LLAMA-CPP",
      "resources/models/LICENSE-CPP-HTTPLIB",
      "resources/models/LICENSE-NLOHMANN-JSON",
      "resources/licenses/NOTICE.md",
      "resources/licenses/LICENSE-SQLCIPHER",
      "../scripts/ph7"
    ],
    "shortDescription": "Private Command Console",
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
